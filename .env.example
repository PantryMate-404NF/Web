# 브라우저가 호출하는 API 주소입니다. 로컬 프록시 사용 시 프론트 개발 서버 주소를 입력합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Next.js 서버가 전달할 실제 백엔드 Gateway 주소입니다. 요청 경로의 /api는 포함하지 않습니다.
# 예: http://221.166.239.233:8080
BACKEND_API_BASE_URL=

# MSW 목업을 사용할 로컬 개발 환경에서만 enabled로 설정합니다.
# 실제 백엔드와 연동할 때는 비워 둡니다.
NEXT_PUBLIC_API_MOCKING=
