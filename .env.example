# 브라우저가 호출하는 API 주소입니다. 로컬 프록시 사용 시 프론트 개발 서버 주소를 입력합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase Web Push 설정입니다. 값은 브라우저에 공개되므로 프로젝트용 Firebase 공개 설정을 사용하세요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 기존 통합 Gateway 주소입니다. 서비스별 주소를 설정하지 않을 때만 사용합니다
BACKEND_API_BASE_URL=

# 로컬에서 서비스별 API를 직접 연결할 때 사용합니다. 요청 경로의 /api는 포함하지 않습니다
AUTH_API_BASE_URL=http://localhost:8080
PANTRY_RECIPE_API_BASE_URL=http://localhost:8082
PRODUCT_API_BASE_URL=http://localhost:8083

# 토스페이먼츠 결제창 테스트 클라이언트 키입니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# MSW 목업을 사용할 로컬 개발 환경에서만 enabled로 설정합니다.
# 실제 백엔드와 연동할 때는 비워 둡니다.
NEXT_PUBLIC_API_MOCKING=

# 실제 상품 ID가 API 응답과 연결된 환경에서만 enabled로 설정합니다.
# 비어 있으면 개발 환경은 로컬 preview를 사용하고 운영 환경은 쓰기 동작을 비활성화합니다.
NEXT_PUBLIC_CART_WRITE_API_ENABLED=
